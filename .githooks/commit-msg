#!/usr/bin/env bash
# Conventional Commits validator (no Node required).
# Accepts:
#   type(scope)!: subject
#   type: subject
# Where type is one of the allowed conventional-commit types.
set -euo pipefail

msg_file="${1:-}"
if [[ -z "${msg_file}" || ! -f "${msg_file}" ]]; then
  echo "commit-msg hook: missing commit message file" >&2
  exit 1
fi

# Read the first non-comment, non-empty line as the header.
header=""
while IFS= read -r line; do
  case "${line}" in
    \#*) continue ;;
    "") continue ;;
    *) header="${line}"; break ;;
  esac
done < "${msg_file}"

# Allow merge / revert / fixup / squash auto-messages.
case "${header}" in
  Merge*|Revert*|"fixup!"*|"squash!"*|"amend!"*)
    exit 0
    ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .{1,}$'
if [[ ! "${header}" =~ ${pattern} ]]; then
  cat >&2 <<EOF
✖  Commit message does not follow Conventional Commits.

  Header was: "${header}"

  Required form:  <type>(<scope>)?!?: <subject>
  Allowed types:  feat, fix, docs, style, refactor, perf,
                  test, build, ci, chore, revert
  Examples:
    feat(api): add /vrf list endpoint
    fix(bgp): handle empty community lists
    refactor!: rename Session to Peer

EOF
  exit 1
fi

# Header length check (matches commitlint header-max-length=100).
if (( ${#header} > 100 )); then
  echo "✖  Commit header is ${#header} chars; max 100." >&2
  exit 1
fi

exit 0
